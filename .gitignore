__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
build/
dist/
*.whl
results/*.log
# working output; the curated set is copied to analysis/benchmark_outputs/.
# The comment must be on its own line: git has no trailing comments, so
# "results/  # ..." was one literal pattern that matched nothing and left
# every run's output showing as untracked.
results/
docs/figures/
rivm_test_set.fasta
validation/results_rivm.csv
validation/test_result_3.csv
validation/*.fasta
missing_accessions.txt
recomb_out/
aligned.fasta

# brand asset bundle as delivered; its contents live in assets/
*.zip
# Deposit staging: the archives are built, not stored, but the prose that
# describes the deposit is written once and belongs in git.
zenodo/*
!zenodo/DESCRIPTION.txt
!zenodo/UPLOAD_NOTES.md

# --- 8. Reference set and datasets: distributed via Zenodo, not git ---
# doi:10.5281/zenodo.24161236 -- fetched by `calicityper setup`, verified against
# calicityper/data/reference_manifest.json. The manifest, the accession list and
# the derived bounds table stay tracked; the sequences and alignments do not.
calicityper/data/database/
calicityper/data/reference_sequences_RdRp/
calicityper/data/reference_sequences_VP1/
calicityper/data/reference_sequences_sapovirus_RdRp/
calicityper/data/reference_sequences_sapovirus_VP1/

calicityper/data/.cache/

# Host cache for the Apptainer build: ~335 MB of upstream tarballs, so a build
# does not depend on those hosts being up. Repopulate with
# containers/fetch_cache.sh; the definition downloads anything absent.
containers/cache/

# Apptainer image built by containers/calicityper-tools.def (335 MB)
containers/*.sif
