Bootstrap: docker
From: python:3.11-slim

# External tools for CaliciTyper, pinned, in one image.
#
#   apptainer build calicityper-tools.sif containers/calicityper-tools.def
#
# Built WITHOUT apt-get, deliberately. On an HPC system where the account has
# no /etc/subuid range and neither fakeroot nor proot is installed, Apptainer
# falls back to a root-mapped namespace in which apt-get cannot drop
# privileges to the _apt user and dies with
#   E: setgroups 65534 failed - setgroups (1: Operation not permitted)
# Everything else in %post works in that namespace, so this recipe uses a base
# image that already carries Python and installs the other two tools from
# prebuilt binaries fetched and unpacked with Python's own stdlib. No
# compilation, no package manager, no privilege.
#
# OpenRDP needs numpy<2 while CaliciTyper runs numpy>=2, so OpenRDP gets its
# own interpreter inside the image. See docs/INSTALL_TOOLS.md.

%labels
    Description  BLAST+, MAFFT and OpenRDP for CaliciTyper
    BLAST        2.17.0+
    MAFFT        7.526
    OpenRDP      0.1.0

%post
    set -eux

    python3 - <<'PY'
import tarfile, urllib.request, pathlib, shutil, os

def fetch(url, dest):
    print(f"fetching {url}", flush=True)
    urllib.request.urlretrieve(url, dest)

# --- BLAST+ 2.17.0, prebuilt x64 linux ------------------------------------
fetch("https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.17.0/"
      "ncbi-blast-2.17.0+-x64-linux.tar.gz", "/tmp/blast.tar.gz")
with tarfile.open("/tmp/blast.tar.gz") as t:
    t.extractall("/opt")
os.rename("/opt/ncbi-blast-2.17.0+", "/opt/blast")
os.remove("/tmp/blast.tar.gz")
# the full set is ~300 MB; keep only what CaliciTyper invokes
keep = {"blastn", "makeblastdb"}
for p in pathlib.Path("/opt/blast/bin").iterdir():
    if p.is_file() and p.name not in keep:
        p.unlink()

# --- MAFFT 7.526, portable package (no compilation) -----------------------
fetch("https://mafft.cbrc.jp/alignment/software/mafft-7.526-linux.tgz",
      "/tmp/mafft.tgz")
with tarfile.open("/tmp/mafft.tgz") as t:
    t.extractall("/opt")
os.remove("/tmp/mafft.tgz")
print("mafft tree:", os.listdir("/opt/mafft-linux64"), flush=True)
PY

    # the portable MAFFT entry point is a wrapper script that locates its own
    # binaries relative to itself, so it is linked rather than copied
    ln -s /opt/mafft-linux64/mafft.bat /usr/local/bin/mafft

    # --- OpenRDP 0.1.0, isolated interpreter (numpy<2) --------------------
    python3 -m venv /opt/openrdp-venv
    /opt/openrdp-venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/openrdp-venv/bin/pip install --no-cache-dir 'numpy<2' 'openrdp==0.1.0'
    ln -s /opt/openrdp-venv/bin/openrdp /usr/local/bin/openrdp

%environment
    export PATH=/opt/blast/bin:/usr/local/bin:$PATH
    export LC_ALL=C

%test
    set -e
    blastn -version
    makeblastdb -version | head -1
    mafft --version
    openrdp --help > /dev/null && echo "openrdp ok"
    /opt/openrdp-venv/bin/python -c "import numpy; assert numpy.__version__.startswith('1.'), numpy.__version__; print('openrdp numpy', numpy.__version__)"

%runscript
    exec "$@"

%help
    Pinned external tools for CaliciTyper.

      apptainer exec calicityper-tools.sif blastn -version
      apptainer exec calicityper-tools.sif mafft --version
      apptainer exec calicityper-tools.sif openrdp --help

    Bind anything outside $HOME that a run must read or write:

      apptainer exec -B /scratch calicityper-tools.sif blastn ...

    Point CaliciTyper at these with CALICITYPER_BLASTN, CALICITYPER_MAKEBLASTDB,
    CALICITYPER_MAFFT and CALICITYPER_OPENRDP; docs/INSTALL_TOOLS.md has
    wrapper scripts that do this.
