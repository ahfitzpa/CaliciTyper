Bootstrap: localimage
From: calicityper-tools.sif

# Application image layered on calicityper-tools.sif (build from repo root, tools image first).
# Reference data is not baked in (doi:10.5281/zenodo.24354774); bind a host copy to /data or set CALICITYPER_DATA.

%files
    pyproject.toml /opt/calicityper-src/pyproject.toml
    README.md      /opt/calicityper-src/README.md
    calicityper    /opt/calicityper-src/calicityper

%labels
    Description   CaliciTyper + BLAST+, MAFFT, ClustalW, IQ-TREE, OpenRDP
    Entrypoint    calicityper
    Data.mount    /data
    Data.setup    apptainer exec -B ./refdata:/data calicityper.sif calicityper setup
    Tools         blastn, makeblastdb, mafft, clustalw2, iqtree, openrdp
    Cpu.default   1
    Cpu.useful    4

%post
    set -eu
    export PATH=/opt/env/bin:/usr/local/bin:$PATH
    mkdir -p /data
    # Install into the lock conda env offline, leaving all conda-pinned dependencies untouched.
    /opt/env/bin/pip install --no-cache-dir --no-build-isolation --no-deps /opt/calicityper-src
    /opt/env/bin/python -c "from calicityper import tree; tree.warmup()"
    calicityper --help > /dev/null

%environment
    case ":$PATH:" in
        *":/opt/env/bin:"*) ;;
        *) export PATH=/opt/env/bin:/usr/local/bin:$PATH ;;
    esac
    export LC_ALL=C
    export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-${TMPDIR:-/tmp}/calicityper-numba-cache}"
    # Leave CALICITYPER_DATA unset so config.py defaults to /data while still allowing --env overrides.

%test
    set -e
    calicityper --help > /dev/null && echo "calicityper ok"
    /opt/env/bin/python -c "import calicityper, numpy, pandas, Bio; from calicityper import tree; tree.warmup(); print('python + numba ok')"
    blastn -version | head -1
    makeblastdb -version | head -1
    mafft --version
    clustalw2 -help > /dev/null 2>&1 && echo "clustalw2 ok"
    iqtree --version | head -1
    openrdp --help > /dev/null && echo "openrdp ok"

%runscript
    exec calicityper "$@"

%help
    CaliciTyper and all external tools (BLAST+, MAFFT, ClustalW, IQ-TREE, OpenRDP).

    Reference data (bind-mounted at /data by default, or set CALICITYPER_DATA):
      mkdir -p refdata
      apptainer exec -B ./refdata:/data calicityper.sif calicityper setup
      apptainer run  -B ./refdata:/data calicityper.sif type --help
